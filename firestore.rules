rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Matches any document under the 'users' collection or its subcollections
    match /users/{userId}/{document=**} {
      // Allows read and write operations only if the requesting user is authenticated
      // and their authenticated UID matches the document's userId.
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
